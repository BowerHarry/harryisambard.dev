# Copy to .env and fill in — .env is gitignored, these are the same three values
# that go in Cloudflare Pages → Settings → Environment variables.
#
# App key and secret: dropbox.com/developers/apps → your app → Settings.
# Refresh token: authorise the app, then exchange the code (see README).

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
